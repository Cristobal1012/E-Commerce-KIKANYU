{
  "name": "ecommerce-esencias-white-label",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm.cmd run dev --workspaces --if-present",
    "build": "npm.cmd run build --workspaces --if-present",
    "lint": "npm.cmd run lint --workspaces --if-present",
    "type-check": "npm.cmd run type-check --workspaces --if-present",
    "test": "npm.cmd run test --workspaces --if-present",
    "backend:dev": "npm.cmd run dev --workspace @white-label/backend",
    "backend:build": "npm.cmd run build --workspace @white-label/backend",
    "backend:migrations": "npm.cmd run migrations --workspace @white-label/backend",
    "backend:seed:catalog": "npm.cmd run seed:catalog --workspace @white-label/backend",
    "storefront:dev": "npm.cmd run dev --workspace @white-label/storefront",
    "storefront:build": "npm.cmd run build --workspace @white-label/storefront"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.21.2",
    "@medusajs/medusa": "^2.21.2",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "eslint": {
      "ajv": "^6.12.4"
    },
    "@eslint/eslintrc": {
      "ajv": "^6.12.4"
    }
  },
  "allowScripts": {
    "@swc/core": true,
    "esbuild": true,
    "protobufjs": true,
    "unrs-resolver": true,
    "@medusajs/telemetry": true
  }
}
