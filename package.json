{
  "name": "ecommerce-esencias-white-label",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "backend:dev": "turbo dev --filter=@white-label/backend",
    "backend:build": "turbo build --filter=@white-label/backend",
    "backend:migrations": "turbo migrations --filter=@white-label/backend",
    "storefront:dev": "turbo dev --filter=@white-label/storefront",
    "storefront:build": "turbo build --filter=@white-label/storefront"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.21.2",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.6.2",
    "turbo": "^2.6.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "eslint": {
      "ajv": "^6.12.4"
    },
    "@eslint/eslintrc": {
      "ajv": "^6.12.4"
    }
  }
}
